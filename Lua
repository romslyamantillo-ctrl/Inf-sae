-- Engine Custom Toggle Compiler UI Helper
local function CreateToggle(name, callback)
    local Tgl = Instance.new("TextButton")
    Tgl.Size = UDim2.new(1, 0, 0, 40)
    Tgl.BackgroundColor3 = Color3.fromRGB(25, 35, 25)
    Tgl.Text = name .. " [OFF]"
    Tgl.TextColor3 = Color3.fromRGB(180, 200, 180)
    Tgl.TextSize = 14
    Tgl.Font = Enum.Font.SourceSans
    Tgl.Parent = Container
    
    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 6)
    Corner.Parent = Tgl
    
    local active = false
    Tgl.MouseButton1Click:Connect(function()
        active = not active
        if active then
            Tgl.BackgroundColor3 = Color3.fromRGB(40, 130, 65) -- Active State Green
            Tgl.Text = name .. " [ON]"
            Tgl.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            Tgl.BackgroundColor3 = Color3.fromRGB(25, 35, 25)
            Tgl.Text = name .. " [OFF]"
            Tgl.TextColor3 = Color3.fromRGB(180, 200, 180)
        end
        task.spawn(callback, active)
    end)
end

-- 3. CORE LOGIC: Smooth Linear Interpolation Movement (No Instant Teleports)
local function SafeMoveTo(targetCFrame)
    local char = Player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    local distance = (root.Position - targetCFrame.Position).Magnitude
    local speed = 26 -- Calculated speed threshold to slip under Anticheat scanners
    local duration = distance / speed
    
    if duration > 3.5 then duration = 3.5 end -- Keeps tracking seamless
    
    local tween = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
    tween:Play()
    tween.Completed:Wait()
end

